# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — .env.example
# Copy this file to .env.local for local dev overrides.
# Set these as Netlify environment variables for production.
# NEVER commit a file containing real values to Git.
# ============================================================

# Backend API base URL (no trailing slash, no /api suffix).
# Production example: https://dlme-backend.onrender.com
# Leave empty in local dev — Vite proxy handles /api -> localhost:8080
VITE_API_URL=
