# ============================================================
# .gitignore — DLME Project
# ============================================================

# --- Environment Variables (NEVER commit these) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
frontend/.env.production

# --- Node.js Dependencies ---
node_modules/
frontend/node_modules/

# --- Production & Build Outputs ---
dist/
frontend/dist/
target/
backend/target/
backend/bin/
*.jar
*.war

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Uploads & Temp Files ---
uploads/
backend/uploads/
scratch/

# --- H2 Database Files ---
data/
backend/data/
*.mv.db
*.trace.db

# --- IDE & Editor Files ---
.idea/
*.iml
.vscode/*
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Spring Boot ---
HELP.md
