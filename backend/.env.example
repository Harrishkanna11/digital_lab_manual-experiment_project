# ============================================================
# BACKEND ENVIRONMENT VARIABLES — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to Git.
# ============================================================

# Spring profile to activate: prod | dev | h2
SPRING_PROFILES_ACTIVE=prod

# --- Supabase / PostgreSQL Database ---
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
# Get from Supabase: Project Settings > Database > Connection string (JDBC)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT Authentication ---
# Use a strong random secret (minimum 32 chars / 256 bits).
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- CORS — Frontend URL ---
# Set to your deployed Netlify URL, e.g. https://your-site.netlify.app
# Multiple URLs can be comma-separated: https://app.netlify.app,http://localhost:5173
FRONTEND_URL=

# --- Server ---
PORT=8080

# --- File Uploads ---
UPLOAD_DIR=./uploads

# --- Demo Data Seeding ---
# Set to false in production. Set to true only for demo/dev environments.
SEED_DEMO_DATA=false
