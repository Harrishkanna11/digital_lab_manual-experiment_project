-- Sample Faculty
INSERT INTO faculty (user_id, faculty_id, designation, created_at, updated_at)
SELECT u.id, 'FAC001', 'Professor & HOD', NOW(), NOW()
FROM users u WHERE u.email = 'faculty@digitallab.edu'
ON CONFLICT DO NOTHING;

-- Sample Student
INSERT INTO students (user_id, register_number, year, section, created_at, updated_at)
SELECT u.id, '21CS101', 3, 'A', NOW(), NOW()
FROM users u WHERE u.email = 'student@digitallab.edu'
ON CONFLICT DO NOTHING;

-- Sample Subjects
INSERT INTO subjects (subject_name, course_code, department, year, semester, academic_year, faculty_id, created_at, updated_at)
SELECT 'Data Structures and Algorithms Lab', 'CS301', 'Computer Science and Engineering', 3, 5, '2024-2025', f.id, NOW(), NOW()
FROM faculty f JOIN users u ON f.user_id = u.id WHERE u.email = 'faculty@digitallab.edu'
ON CONFLICT (course_code) DO NOTHING;

INSERT INTO subjects (subject_name, course_code, department, year, semester, academic_year, faculty_id, created_at, updated_at)
